# ============================================================
# 自驱永续进化Agent系统 — 环境变量配置模板
# ============================================================
# 用法:
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 按需修改变量值
#   3. 启动服务/CLI 时会自动读取 .env（阶段175: 已内置自动加载）
#
# 所有变量均为可选。唯一对功能有实质影响的是 SILICONFLOW_API_KEY
# —— 未设置时 LLM 和 RAG 服务不会启用（系统仍可运行核心循环）。
# ============================================================

# ---- 服务配置 ----
# Flask API 服务监听端口
PORT=8080

# Flask API 服务监听地址（0.0.0.0 表示所有网卡）
HOST=0.0.0.0

# 调试模式（true 启用 Flask debug，生产环境请保持 false）
DEBUG=false

# ---- LLM 配置（可选，启用 LLM 对话功能所需）----
# 硅基流动 API 密钥（https://siliconflow.cn 获取）
# 未设置时 LLM 服务不启用
SILICONFLOW_API_KEY=

# LLM 对话模型名称
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 硅基流动 API 基础 URL
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- RAG 配置（可选，启用向量检索功能所需）----
# Embedding 模型名称（用于 RAG 向量化）
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ---- 日志配置（可选，阶段179）----
# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志文件目录（默认 logs/）
LOG_DIR=logs

# 单个日志文件最大字节数（默认 10MB，超过后自动轮转）
LOG_MAX_BYTES=10485760

# 保留的轮转备份文件数（默认 5）
LOG_BACKUP_COUNT=5

# ---- 高级配置（可选，通常无需修改）----
# 以下前缀的环境变量会被批量加载为配置项（12-Factor App 原则）
# 格式: APP_<KEY>=<value>，值会尝试 JSON 解析
# 示例: APP_MAX_CYCLES=100
#       APP_FEATURE_FLAGS={"rag": true, "llm": false}
